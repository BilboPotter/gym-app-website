---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyPartial from '../components/LegacyPartial.astro';
import { siteConfig } from '../lib/site.mjs';
import { faqSchema, homepageSchema } from '../lib/schema.mjs';

const homepageTitle = 'Maatriks — Your Workout, Clearly Planned';
const homepageDescription = 'Maatriks builds your workout, shows every movement, tracks what you complete, and offers optional Auto-progression for your next targets.';
const homepageSocialDescription = 'Plan the session, see every movement, log what happened, and turn on Auto-progression when you want the next target calculated for you.';
const homepageFaqs = [
  {
    question: 'Do I need gym experience?',
    answer: 'No. Maatriks uses your experience, schedule, training focus, session length, and movement exclusions to create a starting program. You can open any exercise for a demonstration and clear instructions, then edit the program as you learn what works for you.',
  },
  {
    question: 'Does Maatriks progress my workouts automatically?',
    answer: 'It can. Auto-progression is optional. When it is on, Maatriks uses your completed working sets and saved rep ranges to calculate the next targets and shows you what changed. This is separate from AI post-workout feedback.',
  },
  {
    question: 'Can I change an exercise during a workout?',
    answer: 'Yes. You can swap a planned exercise or add another exercise during the session. What you complete is saved in the workout record.',
  },
  {
    question: 'Does AI decide my next workout?',
    answer: 'No. AI writes post-workout feedback. Your program remains editable, and optional Auto-progression uses deterministic rules for target changes.',
  },
  {
    question: 'Can I edit my program?',
    answer: 'Yes. You can edit program details and workouts, use templates, add custom exercises, and adopt a program shared with you.',
  },
];
const homepageStructuredData = [
  homepageSchema(homepageDescription),
  faqSchema(homepageFaqs),
];
---

<BaseLayout
  pageTitle={homepageTitle}
  pageDescription={homepageDescription}
  socialTitle={homepageTitle}
  socialDescription={homepageSocialDescription}
  socialImageAlt="Maatriks homepage preview with the current Barbell Bench Press exercise screen"
  siteName="Maatriks"
  structuredData={homepageStructuredData}
  canonicalUrl={`${siteConfig.siteUrl}/`}
  mainStyle="padding:0;"
>
  <div class="story-shell" id="story-shell">
    <svg class="snake-line" id="snake-line" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path class="snake-path-bg" id="snake-path-bg"></path>
      <path class="snake-path-lit" id="snake-path-lit"></path>
    </svg>

    <section class="hero story-section story-section--hero" id="hero">
      <picture class="hero-bg">
        <source
          media="(max-width: 768px)"
          srcset="/assets/hero-gym-mobile-960.webp 960w, /assets/hero-gym-mobile-1440.webp 1440w"
          sizes="100vw" />
        <source
          srcset="/assets/hero-gym-desktop-1800.webp 1800w, /assets/hero-gym-desktop-2400.webp 2400w"
          sizes="100vw" />
        <img
          src="/assets/hero-gym-desktop-1800.webp"
          alt=""
          width="1800"
          height="1005"
          fetchpriority="high"
          decoding="async" />
      </picture>

      <div class="container hero-inner">
        <div class="hero-copy">
          <h1><span class="hero-title-intro">Just show up.</span> <span class="accent">We&apos;ll handle the plan.</span></h1>
          <div class="hero-actions">
            <LegacyPartial name="store-badges" />
          </div>
        </div>

        <div class="hero-phone story-phone" data-snake-anchor>
          <div class="device" role="img" aria-label="Maatriks exercise detail for Barbell Bench Press with a looping movement demonstration and how-to guidance">
            <div class="device-inner">
              <LegacyPartial name="phone-workout" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="journey-section journey-section-clean phone-left" id="step-onboard">
      <div class="container journey-inner">
        <div class="journey-header reveal">
          <div class="step-number"><span aria-hidden="true">01</span><span class="sr-only">Step 1 — Your setup</span></div>
          <h2>Tell us about you</h2>
        </div>

        <div class="journey-copy reveal">
          <p class="journey-summary">
            Set your schedule, experience, training focus, session length, and movement exclusions. Maatriks turns those answers into a starting
            program you can edit whenever you need.
          </p>
        </div>

        <div class="story-phone reveal reveal-left" data-snake-anchor>
          <div class="device" role="img" aria-label="Maatriks onboarding screen asking for training experience level with New selected">
            <div class="device-inner">
              <LegacyPartial name="phone-onboarding" />
            </div>
          </div>
        </div>

        <div class="journey-support reveal">
          <div class="card journey-card">
            <div class="journey-card-label">What this step sets</div>
            <dl class="journey-facts">
              <div class="journey-fact">
                <dt>Input</dt>
                <dd>Schedule, experience, focus, session length, and exclusions.</dd>
              </div>
              <div class="journey-fact">
                <dt>System</dt>
                <dd>A structured starting program.</dd>
              </div>
              <div class="journey-fact">
                <dt>You stay in control</dt>
                <dd>Edit the program whenever you need.</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="journey-section journey-section-photo journey-section-ambient phone-right" id="step-log">
      <div class="container journey-inner">
        <div class="journey-header reveal">
          <div class="step-number"><span aria-hidden="true">02</span><span class="sr-only">Step 2 — In the gym</span></div>
          <h2>Track your weights and sets</h2>
        </div>

        <div class="journey-copy reveal">
          <p class="journey-summary">
            Log warm-ups, working sets, weight, reps, timed exercises, swaps, and anything you add mid-workout. The session
            record follows what you did — not only what was planned.
          </p>
        </div>

        <div class="story-phone reveal reveal-right" data-snake-anchor>
          <div class="device" role="img" aria-label="Maatriks active Full Body A workout with Barbell Bench Press warm-ups, working sets, weight, and reps">
            <div class="device-inner">
              <LegacyPartial name="phone-workout-leg" />
            </div>
          </div>
        </div>

        <div class="journey-support reveal">
          <div class="card journey-card">
            <div class="journey-card-label">What this step captures</div>
            <dl class="journey-facts">
              <div class="journey-fact">
                <dt>Track</dt>
                <dd>Warm-ups, working sets, weight, reps, and timed work.</dd>
              </div>
              <div class="journey-fact">
                <dt>Change</dt>
                <dd>Swap exercises or add one on the spot.</dd>
              </div>
              <div class="journey-fact">
                <dt>Stay moving</dt>
                <dd>Use built-in rest and exercise timers. Warm-up rest can be switched off.</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="journey-section journey-section-clean journey-section-accent phone-left" id="step-feedback">
      <div class="container journey-inner">
        <div class="journey-header reveal">
          <div class="step-number"><span aria-hidden="true">03</span><span class="sr-only">Step 3 — After the session</span></div>
          <h2>Review results</h2>
        </div>

        <div class="journey-copy reveal">
          <p class="journey-summary">
            After you submit, Maatriks turns the session into a clear summary with completed work, volume, new PRs, streak
            context, and coach-style feedback. Auto-progression stays separate and shows target changes only when it is enabled.
          </p>
        </div>

        <div class="story-phone reveal reveal-left" data-snake-anchor>
          <div class="device" role="img" aria-label="Maatriks workout reflection showing coach-style feedback, total volume, session statistics, and completed exercises">
            <div class="device-inner">
              <LegacyPartial name="phone-feedback" />
            </div>
          </div>
        </div>

        <div class="journey-support reveal">
          <div class="card journey-card">
            <div class="journey-card-label">What this step reviews</div>
            <dl class="journey-facts">
              <div class="journey-fact">
                <dt>Review</dt>
                <dd>Completed exercises, volume, and session stats.</dd>
              </div>
              <div class="journey-fact">
                <dt>Reflect</dt>
                <dd>Add how the workout felt.</dd>
              </div>
              <div class="journey-fact">
                <dt>Understand</dt>
                <dd>Read post-workout feedback without hiding the underlying data.</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="journey-section journey-section-photo journey-section-ambient phone-right" id="step-results">
      <div class="container journey-inner">
        <div class="journey-header reveal">
          <div class="step-number"><span aria-hidden="true">04</span><span class="sr-only">Step 4 — Over time</span></div>
          <h2>See the progress</h2>
        </div>

        <div class="journey-copy reveal">
          <p class="journey-summary">
            Your level and XP, weekly streak, workout calendar, and recent sessions keep progress visible without a
            spreadsheet.
          </p>
        </div>

        <div class="story-phone reveal reveal-right" data-snake-anchor>
          <div class="device" role="img" aria-label="Maatriks dashboard showing level progress, weekly streak, workout calendar, and recent activity">
            <div class="device-inner">
              <LegacyPartial name="phone-dashboard" />
            </div>
          </div>
        </div>

        <div class="journey-support reveal">
          <div class="card journey-card">
            <div class="journey-card-label">What this step surfaces</div>
            <dl class="journey-facts">
              <div class="journey-fact">
                <dt>See</dt>
                <dd>Level, XP, and weekly streak.</dd>
              </div>
              <div class="journey-fact">
                <dt>Review</dt>
                <dd>Your workout calendar and recent sessions.</dd>
              </div>
              <div class="journey-fact">
                <dt>Return</dt>
                <dd>Pick up from a clear view of what you have done.</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="product-proof-section section-block" id="product-proof">
    <div class="container product-proof-layout">
      <div class="section-head product-proof-head reveal">
        <div class="section-label">Inside Maatriks</div>
        <h2>Your whole workout, in one place</h2>
      </div>

      <div class="product-proof-grid">
        <article class="product-proof-card reveal">
          <div class="product-proof-copy">
            <div class="product-proof-index">01 / Exercise</div>
            <h3>Exercise guidance that moves</h3>
            <p>Open an exercise to see a looping demonstration, the muscles involved, clear how-to steps, and your own history.</p>
          </div>
          <div class="product-proof-media product-proof-media--live">
            <img
              src="/assets/product-exercise-squat.jpg"
              alt="Barbell Squat exercise detail showing the demonstration, muscle tags, and how-to steps"
              width="828"
              height="1709"
              loading="lazy"
              decoding="async" />
            <div class="proof-video-frame" aria-hidden="true">
              <video
                class="exercise-video"
                data-exercise-video
                autoplay
                muted
                loop
                playsinline
                preload="none"
                poster="/assets/barbell-squat.webp"
                tabindex="-1">
                <source data-src="/assets/barbell-squat.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </article>

        <article class="product-proof-card reveal">
          <div class="product-proof-copy">
            <div class="product-proof-index">02 / Logging</div>
            <h3>Logging built for the gym</h3>
            <p>Track warm-ups, working sets, weight, reps, timed work, swaps, rest timers, and exercises you add on the spot.</p>
          </div>
          <div class="product-proof-media">
            <img
              src="/assets/product-workout-active.jpg"
              alt="Active Full Body A workout showing exercise thumbnails, warm-ups, working sets, weight, and reps"
              width="828"
              height="1709"
              loading="lazy"
              decoding="async" />
          </div>
        </article>

        <article class="product-proof-card reveal">
          <div class="product-proof-copy">
            <div class="product-proof-index">03 / Review</div>
            <h3>A clear review after every session</h3>
            <p>See the work you completed, volume, streak context, new PRs, and coach-style feedback in one reflection-first summary.</p>
          </div>
          <div class="product-proof-media">
            <img
              src="/assets/product-workout-summary.jpg"
              alt="Completed workout reflection showing coach-style feedback, total volume, duration, sets, exercises, and PRs"
              width="828"
              height="1709"
              loading="lazy"
              decoding="async" />
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="timers-section section-block" id="timers">
    <div class="container timers-layout">
      <div class="timers-copy reveal">
        <div class="section-label">Built-in timing</div>
        <h2>Keep the clock inside the workout</h2>
        <p class="lead">
          Set time-based work directly on an exercise, start the timer without leaving the session, and finish to save
          the time you actually completed.
        </p>
        <p>
          With warm-up rest enabled, its countdown starts after a completed warm-up. Adjust the countdown, minimize or
          skip it, or switch the feature off in settings.
        </p>

        <dl class="timers-facts">
          <div>
            <dt>Timed sets</dt>
            <dd>Targets stay beside the exercise.</dd>
          </div>
          <div>
            <dt>Saved result</dt>
            <dd>Finish logs the completed time to that set.</dd>
          </div>
        </dl>
      </div>

      <div class="timers-phone-wrap reveal">
        <div class="timers-live-label">Live timed set</div>
        <div
          class="device timers-phone"
          role="img"
          aria-label="Maatriks timed Hand Plank set starting and counting inside the active workout">
          <div class="device-inner">
            <LegacyPartial name="phone-timed-exercise" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="auto-progression-section section-block" id="auto-progression">
    <div class="auto-progression-graph" data-auto-progression-graph aria-hidden="true">
      <svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="progression-line-gradient" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stop-color="#e06800" stop-opacity="0.32" />
            <stop offset="58%" stop-color="#ff8a1f" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#ffd080" />
          </linearGradient>
          <linearGradient id="progression-glow-gradient" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stop-color="#e06800" stop-opacity="0.08" />
            <stop offset="58%" stop-color="#ff8a1f" stop-opacity="0.18" />
            <stop offset="100%" stop-color="#ffb347" stop-opacity="0.286" />
          </linearGradient>
          <linearGradient id="progression-area-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ff8a1f" stop-opacity="0.16" />
            <stop offset="100%" stop-color="#ff8a1f" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path
          class="auto-progression-graph-area"
          d="M-40 620 C90 600 160 560 250 570 S420 510 510 500 S660 430 735 445 S900 350 980 300 S1110 235 1200 190 L1200 700 L-40 700 Z"
        />
        <path
          class="auto-progression-graph-glow"
          pathLength="1"
          d="M-40 620 C90 600 160 560 250 570 S420 510 510 500 S660 430 735 445 S900 350 980 300 S1110 235 1200 190"
        />
        <path
          class="auto-progression-graph-line"
          pathLength="1"
          d="M-40 620 C90 600 160 560 250 570 S420 510 510 500 S660 430 735 445 S900 350 980 300 S1110 235 1200 190"
        />
        <g class="auto-progression-graph-points">
          <circle class="auto-progression-graph-point auto-progression-graph-point--one" cx="250" cy="570" r="5" />
          <circle class="auto-progression-graph-point auto-progression-graph-point--two" cx="735" cy="445" r="5" />
          <circle class="auto-progression-graph-point auto-progression-graph-point--three" cx="980" cy="300" r="6" />
        </g>
      </svg>
    </div>
    <div class="container auto-progression-layout">
      <div class="auto-progression-copy reveal">
        <div class="section-label">Auto-progression</div>
        <h2>Know what to aim for next</h2>
        <p class="lead">
          Maatriks calculates the next target from the working sets you complete and the rep range saved in your program.
          Clear rules decide the change, and you can see it before the next session.
        </p>
        <p>Auto-progression is optional and can be switched on or off in your program settings.</p>
      </div>

      <div class="auto-progression-flow reveal" aria-label="How Auto-progression calculates a next target">
        <div class="auto-progression-status">Clear rules · Visible changes</div>
        <ol>
          <li>
            <span class="auto-progression-step">01</span>
            <div>
              <strong>Completed work</strong>
              <p>Use the working sets you actually finished.</p>
            </div>
          </li>
          <li>
            <span class="auto-progression-step">02</span>
            <div>
              <strong>Rep-range rules</strong>
              <p>Compare the result with the range saved in your program.</p>
            </div>
          </li>
          <li>
            <span class="auto-progression-step">03</span>
            <div>
              <strong>Next target</strong>
              <p>Show the calculated change before the next session.</p>
            </div>
          </li>
        </ol>
        <div class="auto-progression-separation">
          <span>Your program</span>
          <strong>A clear next step</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section section-block" id="faq">
    <div class="container faq-inner">
      <div class="section-head reveal">
        <div class="section-label">FAQ</div>
        <h2>Common questions</h2>
      </div>

      <div class="faq-list reveal">
        {
          homepageFaqs.map(({ question, answer }) => (
            <details class="faq-item">
              <summary>
                <span>{question}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="faq-answer">
                <p>{answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="newsletter-section section-block" id="newsletter">
    <div class="container newsletter-inner reveal">
      <div class="section-label">Newsletter</div>
      <h2>Get training tips that actually help</h2>
      <p>Training ideas and product updates are on the way. Signup will open here once the mailing list is ready.</p>
      <div class="newsletter-status" role="status">
        <span class="newsletter-status-dot" aria-hidden="true"></span>
        Signup coming soon
      </div>
    </div>
  </section>

  <section class="download-section section-block" id="download">
    <div class="container download-inner reveal">
      <div class="section-label">Download</div>
      <h2>Your first workout is one setup away</h2>
      <p>
        Download Maatriks, answer a few questions, and start with a program you can edit. Turn on Auto-progression when
        you want the app to calculate your next targets.
      </p>

      <div class="download-actions">
        <LegacyPartial name="store-badges" />
      </div>
    </div>
  </section>
</BaseLayout>
